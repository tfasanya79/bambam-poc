# Copy this file to .env to turn on the optional language model.
# The app runs fine without it: change classification falls back to
# deterministic rules, which need no network and no API key.

# Any OpenAI-compatible endpoint works (OpenAI, Azure OpenAI, OpenRouter, Ollama).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL=gpt-4o-mini

# Set to 0 to force rule-based classification even when a key is present.
ENABLE_LLM=1

# Web server settings.
# PORT is the port to listen on.
# HOST 0.0.0.0 lets colleagues on your network connect; 127.0.0.1 keeps it local only.
PORT=4310
HOST=0.0.0.0
